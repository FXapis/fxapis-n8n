{
	"name": "n8n-nodes-fxapis",
	"version": "0.1.2",
	"description": "n8n node for fxapis, the hosted MetaTrader 5 REST API: place and close MT5 orders, read accounts and history, and trigger workflows on signed trading webhooks. No terminal, VPS or EA.",
	"license": "MIT",
	"homepage": "https://docs.fxapis.com",
	"keywords": [
		"n8n-community-node-package",
		"n8n",
		"mt5",
		"mt5-api",
		"metatrader",
		"metatrader5",
		"trading",
		"trading-api",
		"forex"
	],
	"author": {
		"name": "fxapis",
		"email": "support@fxapis.com",
		"url": "https://fxapis.com"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/FXapis/fxapis-n8n.git"
	},
	"bugs": {
		"url": "https://github.com/FXapis/fxapis-n8n/issues"
	},
	"engines": {
		"node": ">=20.19"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"lint:scan": "eslint --no-inline-config nodes credentials",
		"test": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --disable-warning=ExperimentalWarning --import ./tests/register.mjs --test tests/*.test.ts",
		"typecheck": "tsc --noEmit",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist",
		"!dist/tsconfig.tsbuildinfo",
		"!dist/package.json"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/FxapisApi.credentials.js",
			"dist/credentials/FxapisMt5LoginApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/Fxapis/Fxapis.node.js",
			"dist/nodes/FxapisTrigger/FxapisTrigger.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "1.0.1",
		"@types/node": "^26.6.6",
		"eslint": "10.13.0",
		"n8n-workflow": "^2.16.0",
		"prettier": "3.9.10",
		"release-it": "21.1.1",
		"typescript": "5.9.3"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
