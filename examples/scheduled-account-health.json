{
  "name": "fxapis: scheduled account health check",
  "nodes": [
    {
      "id": "c7d3a1e2-0003-4000-8000-000000000001",
      "name": "Note",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -80,
        -340
      ],
      "parameters": {
        "content": "## Account health every 15 minutes\n\nReads every account with its last balance, equity and margin level, and flags an account that needs attention (the broker refused the login, trading is off) or whose margin level is under 150%.\n\nThe API key needs only `accounts:read`. Replace the URL in **Send Alert**.",
        "width": 480,
        "height": 260
      }
    },
    {
      "id": "c7d3a1e2-0003-4000-8000-000000000002",
      "name": "Every 15 Minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 15
            }
          ]
        }
      }
    },
    {
      "id": "c7d3a1e2-0003-4000-8000-000000000003",
      "name": "Get Accounts",
      "type": "n8n-nodes-fxapis.fxapis",
      "typeVersion": 1,
      "position": [
        220,
        0
      ],
      "parameters": {
        "resource": "account",
        "operation": "list",
        "returnAll": true
      }
    },
    {
      "id": "c7d3a1e2-0003-4000-8000-000000000004",
      "name": "Needs Attention",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        440,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "6f1d2b3c-4a5e-4f60-8a7b-9c0d1e2f3a41",
              "leftValue": "={{ $json.problem !== null || $json.tradingDisabled === true || ($json.marginLevel !== null && Number($json.marginLevel) < 150) }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "c7d3a1e2-0003-4000-8000-000000000005",
      "name": "Send Alert",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        680,
        -20
      ],
      "parameters": {
        "method": "POST",
        "url": "https://hooks.example.com/REPLACE_ME",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ text: ($json.label || $json.login) + ' on ' + $json.server + ': ' + $json.state + ($json.problem ? ' - ' + $json.problem.title : '') + ', equity ' + $json.equity + ', margin level ' + $json.marginLevel + '%' }) }}",
        "options": {}
      }
    }
  ],
  "connections": {
    "Every 15 Minutes": {
      "main": [
        [
          {
            "node": "Get Accounts",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get Accounts": {
      "main": [
        [
          {
            "node": "Needs Attention",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Needs Attention": {
      "main": [
        [
          {
            "node": "Send Alert",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "pinData": {},
  "settings": {
    "executionOrder": "v1"
  },
  "meta": {
    "templateCredsSetupCompleted": false
  }
}